    {
      "parameters": {
        "jsCode": "const leads = $input.all();\n\nconst alta = leads.filter(item => item.json.Prioridade === 'Alta');\nconst media = leads.filter(item => item.json.Prioridade === 'Média');\nconst baixa = leads.filter(item => item.json.Prioridade === 'Baixa');\n\nfunction criarLeads(lista) {\n  return lista.slice(0, 5).map(item => {\n    const lead = item.json;\n\n    return `\n      <div style=\"margin-bottom:12px;padding:12px;border:1px solid #ddd;border-radius:8px;\">\n        <strong>${lead.Nome || 'Sem nome'}</strong>\n        ${lead.Empresa ? ` — ${lead.Empresa}` : ''}<br>\n        💼 ${lead['Serviço pretendido'] || 'Sem serviço'}<br>\n        💰 ${lead['Orçamento disponível'] || 'Sem orçamento'}<br>\n        📧 ${lead['E-mail'] || 'Sem email'}\n      </div>\n    `;\n  }).join('');\n}\n\nfunction resumoPrioridade(titulo, emoji, lista) {\n  const restantes = lista.length - 5;\n\n  return `\n    <h2>${emoji} ${titulo} — ${lista.length} leads</h2>\n    ${lista.length\n      ? criarLeads(lista)\n      : '<p>Nenhum lead nesta categoria.</p>'}\n    ${restantes > 0\n      ? `<p><strong>+ ${restantes} outros leads</strong> — consulte o Google Sheets.</p>`\n      : ''}\n  `;\n}\n\nconst data = new Date().toLocaleDateString('pt-PT');\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:700px;margin:auto;\">\n\n  <h1>📊 Relatório Diário de Leads</h1>\n  <p>Data: <strong>${data}</strong></p>\n\n  <div style=\"padding:15px;background:#f5f5f5;border-radius:8px;margin-bottom:25px;\">\n    <strong>Resumo do dia</strong><br><br>\n    🔴 Alta: <strong>${alta.length}</strong><br>\n    🟡 Média: <strong>${media.length}</strong><br>\n    🟢 Baixa: <strong>${baixa.length}</strong><br>\n    📊 Total: <strong>${leads.length}</strong>\n  </div>\n\n  ${resumoPrioridade('Alta Prioridade', '🔴', alta)}\n\n  ${resumoPrioridade('Média Prioridade', '🟡', media)}\n\n  ${resumoPrioridade('Baixa Prioridade', '🟢', baixa)}\n\n  <p style=\"margin-top:30px;color:#666;\">\n    Os restantes leads podem ser consultados no Google Sheets.\n  </p>\n\n</div>\n`;\n\nreturn [{\n  json: {\n    subject: `📊 Relatório Diário de Leads — ${data}`,\n    html\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
